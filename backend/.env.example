APP_NAME=SGI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://frontend.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
APP_TIMEZONE=America/Guayaquil

AUTH_API_TOKEN_EXPIRATION=120

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=incident_management_system
DB_USERNAME=sgi
DB_PASSWORD=change-me-db-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=150

FILESYSTEM_DISK=local
INCIDENT_FILESYSTEM_DISK=rustfs
PROFILE_PHOTO_FILESYSTEM_DISK=rustfs

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

RUSTFS_ACCESS_KEY_ID=change-me-rustfs-access-key
RUSTFS_SECRET_ACCESS_KEY=change-me-rustfs-secret-key
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sgi-incidents
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_URL=
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=change-me-reverb-app-id
REVERB_APP_KEY=change-me-reverb-app-key
REVERB_APP_SECRET=change-me-reverb-app-secret
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=reverb

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_TIMEOUT=8
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase/firebase_credentials.json
FIREBASE_TOKEN_LEEWAY_SECONDS=120
FIREBASE_PROJECT=app
FIREBASE_AUTH_TENANT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_DEFAULT_BUCKET=
FIREBASE_CACHE_STORE=file

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8000
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
