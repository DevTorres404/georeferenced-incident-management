# SonarQube host access (the scanner uses http://sonarqube:9000 internally)
SONARQUBE_IMAGE=sonarqube:26.6.0.123539-community
SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli:12.1.0.3233_8.0.1
SONARQUBE_PORT=9002
SONARQUBE_HEALTH_TIMEOUT=360
SONAR_HOST_URL=http://localhost:9002
SONAR_TOKEN=

# Dedicated SonarQube database. Replace every placeholder in the local .env.
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=change_this_password

# Isolated database used only by the PHP coverage test container.
ANALYSIS_DB_NAME=incident_management_system_testing
ANALYSIS_DB_USER=analysis_user
ANALYSIS_DB_PASSWORD=change_this_analysis_password
ANALYSIS_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
